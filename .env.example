# Copia este fichero como .env y rellénalo. Nunca subas el .env al repositorio.
ELEVENLABS_API_KEY=
# Voz por defecto (lista con «node bin/turboframe.mjs voces»)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# ffmpeg y ffprobe vienen con «npm install»; solo si quieres usar otros:
# FFMPEG=/opt/homebrew/bin/ffmpeg
# FFPROBE=/opt/homebrew/bin/ffprobe
# PYTHON=python3
# Navegadores de render a la vez (por defecto, según la RAM: 2 con 16 GB). Bájalo a 1 si el ordenador se congela.
# TURBOFRAME_WORKERS=2
# Navegadores en el render de noche (por defecto 3 con 16 GB: nadie usa el ordenador).
# TURBOFRAME_WORKERS_NOCHE=3
# Agentes de Claude trabajando a la vez en un vídeo (por defecto 2). Más agentes = más Chrome abiertos.
# TURBOFRAME_AGENTES=2
# Chrome de TurboFrame abiertos a la vez entre todos los procesos (por defecto según la RAM: 2 con 16 GB).
# TURBOFRAME_NAVEGADORES=2
# Memoria libre mínima (%) para arrancar algo pesado (render, fotos, ffmpeg…); por debajo, TurboFrame espera.
# TURBOFRAME_MEMORIA_MIN=12
# En macOS TurboFrame corre con la prioridad de fondo del sistema (el ordenador no se nota cargado). «normal» la desactiva.
# TURBOFRAME_PRIORIDAD=normal
