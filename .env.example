# Copia este fichero como .env y rellénalo. Nunca subas el .env al repositorio.
ELEVENLABS_API_KEY=
# Voz por defecto (lista con «node bin/turboframe.mjs voces»)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# ffmpeg y ffprobe vienen con «npm install»; solo si quieres usar otros:
# FFMPEG=/opt/homebrew/bin/ffmpeg
# FFPROBE=/opt/homebrew/bin/ffprobe
# PYTHON=python3
